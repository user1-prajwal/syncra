# Copy to .env and fill in. Never commit the real .env file.
PORT=4000
# Comma-separated browser origins allowed to call the API and open WebSockets.
# Leave empty in local development (any origin); set it in production.
ALLOWED_ORIGINS=https://syncra-collab.vercel.app,http://localhost:5173

# ── Code execution (set at least one) ────────────────────────────────────────
# Hosted service with a free quota:
ONLINECOMPILER_API_KEY=your_key_here
# Your OWN Piston server (open source). The public Piston API has been whitelist-only since 2026-02-15.
# PISTON_URL=http://your-server:2000
# PISTON_API_KEY=            # only if your Piston sits behind a key
# Order to try them in (default: piston first, then onlinecompiler). A failing one is skipped automatically.
# EXEC_PROVIDERS=piston,onlinecompiler

# ── Protection for the execution budget (all optional) ───────────────────────
# EXEC_DAILY_LIMIT=500        # total runs per UTC day across all users; 0 = no limit
# EXEC_MAX_CONCURRENT=4       # runs executing at the same moment
# EXEC_MAX_QUEUE=20           # runs allowed to wait; more get a "busy" message
